# Copy to .env and fill in real values:  cp .env.example .env
#
# .env is gitignored and must NEVER be committed. This file is committed
# so anyone cloning the repo knows which variables are required, without
# ever seeing a real secret.

NODE_ENV=development
PORT=3000

# --- Postgres (docker-compose.yml reads these) -----------------------
POSTGRES_USER=financial
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=financial_app
POSTGRES_PORT=5432

# The application's connection string. Host is localhost because the
# container publishes its port to the host; inside another container it
# would be `postgres` (the service name) instead.
DATABASE_URL=postgresql://financial:change-me-locally@localhost:5432/financial_app

# --- Auth (Module 8) --------------------------------------------------
# Generate each with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Two DIFFERENT secrets on purpose: if the access-token secret ever leaks,
# an attacker still cannot mint refresh tokens and keep the session alive.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Short access token limits the damage window if one is stolen; the long
# refresh token is rotated on every use, so a stolen one is detectable.
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Origin allowed to call this API with credentials (the Next.js app).
CORS_ORIGIN=http://localhost:3001

# --- SMS ingest -------------------------------------------------------
# Long random key the phone forwarder sends as the X-Device-Key header.
# Stored hashed in the database; this is only the bootstrap value.
SMS_INGEST_KEY=

# --- LLM fallback for unparsed SMS (Module 7) -------------------------
ANTHROPIC_API_KEY=
