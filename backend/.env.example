# Copy to .env and fill in. .env is gitignored; this file is committed
# so anyone cloning the repo knows which variables are required.

NODE_ENV=development
PORT=3000

# Postgres (added in Module 3)
DATABASE_URL=postgresql://financial:financial@localhost:5432/financial_app

# Device key the phone SMS forwarder sends in the X-Device-Key header
SMS_INGEST_KEY=change-me

# Anthropic API key for the SMS parsing fallback (Module 7)
ANTHROPIC_API_KEY=
