# Copy to .env and fill in real values:  cp .env.example .env
#
# .env is gitignored and must NEVER be committed. This file is committed
# so anyone cloning the repo knows which variables are required, without
# ever seeing a real secret.

NODE_ENV=development
PORT=3000

# --- Postgres (docker-compose.yml reads these) -----------------------
POSTGRES_USER=financial
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=financial_app
POSTGRES_PORT=5432

# The application's connection string. Host is localhost because the
# container publishes its port to the host; inside another container it
# would be `postgres` (the service name) instead.
DATABASE_URL=postgresql://financial:change-me-locally@localhost:5432/financial_app

# --- Auth ------------------------------------------------------------
# Generate each secret with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
#
# Signs ACCESS tokens (JWT, HS256). At least 32 characters.
JWT_ACCESS_SECRET=

# Refresh tokens and device keys are NOT JWTs — they are 256-bit random
# strings, stored as HMAC-SHA256(pepper, token). The pepper lives only in
# the environment, so a leaked database dump alone cannot be used to
# check guessed tokens. At least 32 characters, different from above.
TOKEN_HASH_PEPPER=

# Short access token limits the damage if one is stolen. The refresh
# token is rotated on every use, so a stolen one is detectable.
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d

# Origin(s) allowed to call this API from a browser (the Next.js app).
# Comma-separated for more than one.
CORS_ORIGIN=http://localhost:3001

# Number of reverse proxies in front of the app (0 locally). Needed in
# production so rate limiting sees the real client IP, not the proxy's.
TRUST_PROXY=0

# --- LLM fallback for unparsed SMS (Module 7) -------------------------
ANTHROPIC_API_KEY=
