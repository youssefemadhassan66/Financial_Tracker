# Normalize line endings: LF in the repository, native in the working copy.
* text=auto

# Windows-only files must keep CRLF
*.sln    text eol=crlf
*.slnx   text eol=crlf
*.csproj text eol=crlf
*.cmd    text eol=crlf
*.bat    text eol=crlf

# Shell scripts must keep LF or they break in containers
*.sh     text eol=lf

# Binary files: never touch
*.png binary
*.jpg binary
*.ico binary
*.pdf binary
