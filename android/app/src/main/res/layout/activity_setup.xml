<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/setup_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:colorBackground"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?android:colorBackground"
        app:title="@string/setup_title" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:descendantFocusability="beforeDescendants"
        android:focusableInTouchMode="true"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- 1. Server -->
        <com.google.android.material.card.MaterialCardView style="@style/SetupCard">

            <LinearLayout style="@style/SetupCardBody">

                <TextView style="@style/SetupHeading" android:text="@string/server_heading" />

                <TextView style="@style/SetupText" android:text="@string/server_help" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/server_layout"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="@string/server_hint">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/server"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textUri" />
                </com.google.android.material.textfield.TextInputLayout>

                <Button
                    android:id="@+id/test_server"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/server_test" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 2. Phone key -->
        <com.google.android.material.card.MaterialCardView style="@style/SetupCard">

            <LinearLayout style="@style/SetupCardBody">

                <TextView style="@style/SetupHeading" android:text="@string/key_heading" />

                <TextView
                    android:id="@+id/key_status"
                    style="@style/SetupText"
                    android:textStyle="bold" />

                <TextView style="@style/SetupText" android:text="@string/key_help" />

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="@string/key_hint"
                    app:endIconMode="password_toggle">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/key"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:importantForAutofill="no"
                        android:inputType="textPassword|textNoSuggestions" />
                </com.google.android.material.textfield.TextInputLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/save_key"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/key_save" />

                    <Button
                        android:id="@+id/remove_key"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="@string/key_remove" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 3. Bank SMS -->
        <com.google.android.material.card.MaterialCardView style="@style/SetupCard">

            <LinearLayout style="@style/SetupCardBody">

                <TextView style="@style/SetupHeading" android:text="@string/sms_heading" />

                <TextView
                    android:id="@+id/sms_status"
                    style="@style/SetupText"
                    android:textStyle="bold" />

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="@string/senders_hint"
                    app:helperText="@string/senders_help">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/senders"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textNoSuggestions" />
                </com.google.android.material.textfield.TextInputLayout>

                <Button
                    android:id="@+id/allow_sms"
                    style="@style/Widget.Material3.Button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/sms_allow" />

                <LinearLayout
                    android:id="@+id/restricted_help"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView style="@style/SetupText" android:text="@string/restricted_help" />

                    <Button
                        android:id="@+id/app_settings"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/open_app_info" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 4. Status -->
        <com.google.android.material.card.MaterialCardView style="@style/SetupCard">

            <LinearLayout style="@style/SetupCardBody">

                <TextView style="@style/SetupHeading" android:text="@string/status_heading" />

                <TextView
                    android:id="@+id/queue_status"
                    style="@style/SetupText" />

                <Button
                    android:id="@+id/send_now"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/send_now" />

                <Button
                    android:id="@+id/retry_skipped"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/retry_skipped"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/import_inbox"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/import_inbox" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <Button
            android:id="@+id/done"
            style="@style/Widget.Material3.Button"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:text="@string/done" />
    </LinearLayout>
    </ScrollView>
</LinearLayout>
