<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Same emerald palette as the web app (globals.css). -->
    <color name="brand">#047857</color>
    <color name="brand_on">#FFFFFF</color>
    <color name="surface_light">#F4F4F6</color>
    <color name="surface_dark">#111113</color>

    <!-- No system action bar: screens draw edge to edge (Android 15+) and place their own toolbar. -->
    <style name="Theme.Finance" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand</item>
        <item name="colorOnPrimary">@color/brand_on</item>
        <item name="colorSecondaryContainer">#D1FAE5</item>
        <item name="colorOnSecondaryContainer">#064E3B</item>
        <item name="android:colorBackground">@color/surface_light</item>
        <!-- Neutral surfaces: Material's defaults are tinted purple. -->
        <item name="colorSurface">#FFFFFF</item>
        <item name="colorOnSurface">#1A1A1F</item>
        <item name="colorOnSurfaceVariant">#5B5B66</item>
        <item name="colorSurfaceVariant">#ECECF0</item>
        <item name="colorSurfaceContainerLowest">#FFFFFF</item>
        <item name="colorSurfaceContainerLow">#FFFFFF</item>
        <item name="colorSurfaceContainer">#F4F4F6</item>
        <item name="colorSurfaceContainerHigh">#EEEEF1</item>
        <item name="colorSurfaceContainerHighest">#E8E8EC</item>
        <item name="colorOutline">#C4C4CC</item>
        <item name="colorOutlineVariant">#E2E2E8</item>
    </style>

    <style name="SetupCard" parent="Widget.Material3.CardView.Outlined">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">12dp</item>
        <item name="cardCornerRadius">16dp</item>
    </style>

    <style name="SetupCardBody">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">16dp</item>
    </style>

    <style name="SetupHeading">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textAppearance">?attr/textAppearanceTitleMedium</item>
    </style>

    <style name="SetupText">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:textAppearance">?attr/textAppearanceBodyMedium</item>
    </style>
</resources>
